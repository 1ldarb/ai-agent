import streamlit as st
import requests
import os
from langchain_core.messages import HumanMessage
# Импортируем твой граф из researcher.py
from researcher import app as researcher_app

# 1. Настройка страницы в стиле твоего скриншота
st.set_page_config(page_title="Ildar AI Hub", page_icon="🕵️‍♂️", layout="wide")

# --- БОКОВАЯ ПАНЕЛЬ (Sidebar) ---
with st.sidebar:
    st.title("🛠️ System Architecture")
    
    # Выбор режима работы
    mode = st.radio(
        "Select Active Agent:",
        ["Support Assistant", "Global Researcher"],
        help="Выберите инструмент для работы"
    )
    
    st.info("This system uses RAG and Multi-Agent workflows to provide verified data.")
    
    st.subheader("Tech Stack:")
    st.markdown("""
    * :green[LangGraph] (Orchestration)
    * :green[GPT-4o-mini] (LLM)
    * :green[Pinecone] (Vector DB)
    * :green[SerpApi] (Search)
    """)
    
    if st.button("Reset Session", use_container_width=True):
        st.session_state.messages = []
        st.rerun()

# --- ОСНОВНОЙ ЭКРАН ---
if mode == "Support Assistant":
    st.title("🤖 TechStore Support")
    st.caption("Автономный помощник по базе знаний (faq.txt)")
    
    # Логика чата для поддержки (через твой FastAPI сервер)
    if "support_messages" not in st.session_state:
        st.session_state.support_messages = []

    for msg in st.session_state.support_messages:
        with st.chat_message(msg["role"]):
            st.markdown(msg["content"])

    if prompt := st.chat_input("Спросите о товарах или возврате..."):
        st.session_state.support_messages.append({"role": "user", "content": prompt})
        with st.chat_message("user"): st.markdown(prompt)

        with st.spinner("Сверяюсь с базой знаний..."):
            try:
                # Обращаемся к локальному серверу FastAPI
                res = requests.post("http://127.0.0.1:8000/chat", json={"text": prompt})
                answer = res.json().get("answer", "Ошибка ответа")
            except:
                answer = "❌ Ошибка: Запустите server.py!"
        
        st.session_state.support_messages.append({"role": "assistant", "content": answer})
        with st.chat_message("assistant"): st.markdown(answer)

else:
    # Дизайн один в один как на твоем скриншоте
    st.title("🕵️‍♂️ Global AI Researcher")
    st.caption("Autonomous multi-agent system for deep web research.")
